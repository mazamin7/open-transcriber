<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_badge"
            android:textColor="@color/accent_green"
            android:background="#2000E676"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/btnLanguageSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🇮🇹 Italiano"
            android:textColor="@color/white"
            android:background="@drawable/bg_event_pill"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="8dp" />

        <!-- Incognito Mode / AES-256 Encrypted Storage Toggle Pill -->
        <TextView
            android:id="@+id/btnIncognito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Criptato"
            android:textColor="@color/white"
            android:background="@drawable/bg_event_pill"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />



        <!-- Acoustic Event Badge -->
        <TextView
            android:id="@+id/tvSoundEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sound_silence"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_event_pill"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="12dp" />

        <!-- Google Live Transcribe Iconic Decibel Meter Bubble -->
        <com.transcribe.offline.AudioVisualizerView
            android:id="@+id/audioVisualizer"
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>

    <!-- Main Transcription Viewport -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/quickChipsScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmptyPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/empty_prompt"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginTop="80dp" />

            <TextView
                android:id="@+id/tvTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:lineSpacingMultiplier="1.3"
                android:textIsSelectable="true"
                tools:text="Hello! This text is transcribed completely offline." />

            <TextView
                android:id="@+id/tvInterim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/interim_text"
                android:textSize="32sp"
                android:textStyle="italic"
                tools:text="speaking right now..." />

        </LinearLayout>
    </ScrollView>

    <!-- Quick Response Chips Scroll -->
    <HorizontalScrollView
        android:id="@+id/quickChipsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/chipsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <!-- Programmatically added quick chips -->
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Action Dock -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomDock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Keyboard / Type-Back Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyboard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/surface_dark"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            android:contentDescription="Rispondi con la tastiera"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDictionary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 2. Custom Dictionary Button (Dizionario Nomi) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDictionary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/surface_dark"
            app:icon="@drawable/ic_dictionary"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/accent_green"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            android:contentDescription="Dizionario Nomi e Parole Speciali"
            app:layout_constraintStart_toEndOf="@id/btnKeyboard"
            app:layout_constraintEnd_toStartOf="@id/fabMic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 3. Big Center Microphone FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabCustomSize="64dp"
            app:backgroundTint="@color/accent_green"
            app:tint="@color/black"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Microfono"
            app:layout_constraintStart_toEndOf="@id/btnDictionary"
            app:layout_constraintEnd_toStartOf="@id/btnFloating"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 4. Floating Subtitle Button (Nuvoletta Sovrapposta) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFloating"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/surface_dark"
            app:icon="@drawable/ic_floating"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/accent_green"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            android:contentDescription="Nuvoletta Sottotitoli Flottanti"
            app:layout_constraintStart_toEndOf="@id/fabMic"
            app:layout_constraintEnd_toStartOf="@id/btnClear"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 5. Clear Screen Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/surface_dark"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/text_secondary"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            android:contentDescription="Cancella testo"
            app:layout_constraintStart_toEndOf="@id/btnFloating"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Two-Way Deaf Communication Tray (Type-Back with 180° Table-Flip) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/typeBackCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_dark"
        app:cardCornerRadius="16dp"
        app:cardElevation="16dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Type Back (Reply to Partner)"
                    android:textColor="@color/accent_green"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnCloseTypeBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Text input container with 180° Table-Flip support -->
            <FrameLayout
                android:id="@+id/flipContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#20FFFFFF"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etTypeBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:maxLines="6"
                    android:gravity="top|start"
                    android:background="@null"
                    android:hint="@string/type_back_hint"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <!-- 180° Table-Flip Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlip180"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/flip_180"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/chip_bg"
                    app:cornerRadius="20dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Text-To-Speech Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeakTts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speak_aloud"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/chip_bg"
                    app:cornerRadius="20dp"
                    android:layout_marginEnd="8dp" />

                <!-- Send / Post to stream Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendReply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/send_reply"
                    android:textColor="@color/black"
                    app:backgroundTint="@color/accent_green"
                    app:cornerRadius="20dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
