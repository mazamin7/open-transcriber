<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐"
            android:textSize="26sp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lingue Vocali Offline"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseLanguageDialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary"
            android:contentDescription="Chiudi" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Riconoscimento vocale 100% offline. Scegli tra le lingue installate o scaricane di nuove."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Scanning progress indicator -->
    <LinearLayout
        android:id="@+id/layoutScanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminate="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvScanningStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rilevamento moduli vocali..."
            android:textColor="@color/accent_green"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Scrollable container for both installed and downloadable languages -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="380dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Installed Languages -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MODULI VOCALI INSTALLATI E PRONTI"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/installedLanguagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#12FFFFFF"
                android:padding="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Section 2: Downloadable Languages -->
            <TextView
                android:id="@+id/tvDownloadableTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCARICA NUOVE LINGUE OFFLINE"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/downloadableLanguagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#12FFFFFF"
                android:padding="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Section 3: Manual Settings Help -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_event_pill"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Impostazioni Vocali Android"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Se il download automatico non è supportato dal tuo dispositivo, apri le impostazioni di sistema per scaricare i pacchetti vocali (Gboard / Servizi vocali Google)."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenSpeechSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apri Gestione Tastiere e Voce"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_green"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
